@model List<TechSupport.MVC.Models.IncidenteViewModel>
@{
    ViewData["Title"] = "Gestión de Incidentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">📋 Panel de Incidentes</h2>
        <p class="text-muted mb-0">Gestión de tickets y soporte técnico</p>
    </div>
    <a asp-action="Create" class="btn btn-primary rounded-pill shadow-sm px-4">
        ➕ Reportar Incidente
    </a>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
        <div class="display-6 text-muted mb-3">📭</div>
        <h4 class="fw-bold text-secondary">No hay incidentes registrados</h4>
        <p class="text-muted">Aún no se han creado tickets o no tienes incidentes asignados según tu rol.</p>
        <div class="mt-2">
            <a asp-action="Create" class="btn btn-outline-primary rounded-pill px-4">Crear el primer incidente</a>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4"># ID</th>
                        <th>Título</th>
                        <th>Prioridad</th>
                        <th>Estado</th>
                        <th>Reportado por</th>
                        <th>Técnico</th>
                        <th>Fecha Creación</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var badgePrioridad = item.Prioridad switch
                        {
                            "Critica" => "bg-danger",
                            "Alta" => "bg-warning text-dark",
                            "Media" => "bg-info text-dark",
                            _ => "bg-secondary"
                        };

                        var badgeEstado = item.Estado switch
                        {
                            "Pendiente" => "bg-secondary",
                            "Asignado" => "bg-primary",
                            "EnProceso" => "bg-warning text-dark",
                            "Resuelto" => "bg-success",
                            "Cerrado" => "bg-dark",
                            _ => "bg-light text-dark"
                        };

                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@item.Id</td>
                            <td>
                                <span class="fw-semibold text-dark">@item.Titulo</span>
                                <div class="text-muted small text-truncate" style="max-width: 280px;">@item.Descripcion</div>
                            </td>
                            <td><span class="badge @badgePrioridad rounded-pill px-2 py-1">@item.Prioridad</span></td>
                            <td><span class="badge @badgeEstado rounded-pill px-2 py-1">@item.Estado</span></td>
                            <td>👤 @item.NombreUsuario</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.NombreTecnico))
                                {
                                    <span class="text-primary fw-semibold">🛠️ @item.NombreTecnico</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Sin asignar</span>
                                }
                            </td>
                            <td class="small text-muted">@item.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    Detalles
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
