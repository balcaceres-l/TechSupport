@model TechSupport.MVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión - TechSupport";
}

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="bg-primary bg-gradient text-white rounded-circle d-inline-flex p-3 mb-3 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" class="bi bi-shield-lock" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                            <path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99A1.5 1.5 0 1 1 9.5 6.5"/>
                        </svg>
                    </div>
                    <h3 class="fw-bold text-dark">TechSupport</h3>
                    <p class="text-muted small">Ingresa tus credenciales para acceder al sistema</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <div asp-validation-summary="All" class="text-danger small mb-0"></div>
                    </div>
                }

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="NombreUsuario" class="form-label fw-semibold text-secondary"></label>
                        <input asp-for="NombreUsuario" class="form-control form-control-lg rounded-3" placeholder="Ej: admin, tecnico, usuario..." autocomplete="username" autofocus />
                        <span asp-validation-for="NombreUsuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold text-secondary"></label>
                        <input asp-for="Password" class="form-control form-control-lg rounded-3" placeholder="Contraseña" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-3 shadow-sm fw-semibold">
                        Iniciar Sesión
                    </button>
                </form>

                <div class="mt-4 pt-3 border-top">
                    <h6 class="fw-bold text-dark small text-center mb-3">👥 Cuentas de Prueba Disponibles</h6>
                    
                    <div class="small">
                        <div class="mb-2 p-2 bg-light rounded-2 border">
                            <span class="badge bg-danger me-1">Admin</span>
                            <strong>admin</strong> / <code>Admin123*</code>
                            <span class="text-muted ms-1">(o <strong>admin2</strong>)</span>
                        </div>
                        <div class="mb-2 p-2 bg-light rounded-2 border">
                            <span class="badge bg-warning text-dark me-1">Técnico</span>
                            <strong>tecnico</strong> / <code>Tecnico123*</code>
                            <span class="text-muted ms-1">(o <strong>tecnico2</strong>, <strong>tecnico3</strong>)</span>
                        </div>
                        <div class="p-2 bg-light rounded-2 border">
                            <span class="badge bg-info text-dark me-1">Usuario</span>
                            <strong>usuario</strong> / <code>Usuario123*</code>
                            <span class="text-muted ms-1">(o <strong>usuario2</strong>, <strong>usuario3</strong>)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
