@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="col-md-6 text-center">
        <div class="display-1 text-danger fw-bold mb-3">403</div>
        <h2 class="fw-bold text-dark mb-3">Acceso Denegado</h2>
        <p class="text-muted mb-4 lead">No tienes permisos para acceder al recurso solicitado con tu rol actual (<strong>@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</strong>).</p>
        <a asp-controller="Incidentes" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm">
            Volver al listado de Incidentes
        </a>
    </div>
</div>
