@model ErrorViewModel
@{
    ViewData["Title"] = "Error en la aplicación";
}

<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="col-md-7 text-center">
        <div class="display-3 text-danger mb-3">⚠️</div>
        <h2 class="fw-bold text-dark mb-3">Se ha producido un error</h2>
        <p class="text-muted lead mb-4">
            Ocurrió un problema inesperado al procesar tu solicitud. Nuestro equipo técnico ha sido notificado.
        </p>

        @if (Model?.ShowRequestId == true)
        {
            <div class="alert alert-light border small text-muted d-inline-block px-4 py-2 rounded-pill mb-4">
                Identificador de solicitud (RequestId): <code>@Model.RequestId</code>
            </div>
        }

        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Incidentes" asp-action="Index" class="btn btn-primary rounded-pill px-4 shadow-sm">
                Volver al Inicio
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
                Regresar
            </a>
        </div>
    </div>
</div>
